<?xml version="1.0" encoding="utf-8"?>
<!--
    The light mapping uses accent1_100, which is a light tone in both themes, so without
    this the widget stayed a bright tile on a dark home screen.
-->
<resources>
    <color name="widget_container">@android:color/system_accent1_800</color>
    <color name="widget_on_container">@android:color/system_accent1_100</color>
    <color name="widget_primary">@android:color/system_accent1_200</color>
    <color name="widget_on_primary">@android:color/system_accent1_900</color>
</resources>
